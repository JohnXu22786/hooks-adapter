{
  "name": "hooks-adapter",
  "version": "0.1.0",
  "description": "A universal hooks compatibility layer: run hooks declared in Claude Code / Codex / opencode / native configs on the DeepSeek Harness, with shell, webhook, oracle and proxy handlers.",
  "type": "module",
  "main": "./dsh/plugin.js",
  "exports": {
    ".": "./dsh/plugin.js",
    "./cli": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "hooks-adapter": "./lib/index.js"
  },
  "files": [
    "lib",
    "dsh",
    "cordis.patch.yml",
    "docs",
    "examples",
    "LICENSE",
    "README.md",
    "README.zh.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "hooks",
    "plugin"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
